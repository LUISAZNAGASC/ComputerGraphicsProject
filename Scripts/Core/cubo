#include <iostream>

#include <glad/glad.h>
#include <glfw/glfw3.h>
#include <glm/glm.hpp>
#include <glm/gtc/matrix_transform.hpp>
#include <glm/gtc/type_ptr.hpp>

int main(void)
{
	std::cout << "====================================================================================================" << std::endl;
	std::cout << "----------------------------------------------------------------------------------------------------" << std::endl;
	std::cout << "====================================================================================================" << std::endl;
	std::cout << std::endl;

	if (!glfwInit())
	{
		std::cout << "====================================================================================================" << std::endl;
		std::cout << "ERROR: FAILED TO INITIALIZE GLFW LIBRARY." << std::endl;
		std::cout << "====================================================================================================" << std::endl;
		std::cout << std::endl;

		return -1;
	}

	glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
	glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
	glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);

	constexpr int DisplayerWindowWidth = 1920;
	constexpr int DisplayerWindowHeight = 1080;
	const char* DisplayerWindowTitle = "COMPUTER GRAPHICS PROJECT";

	GLFWwindow* displayerWindowComponent = glfwCreateWindow(DisplayerWindowWidth, DisplayerWindowHeight, DisplayerWindowTitle, nullptr, nullptr);

	if (!displayerWindowComponent)
	{
		std::cout << "====================================================================================================" << std::endl;
		std::cout << "ERROR: FAILED TO CREATE GLFW WINDOW." << std::endl;
		std::cout << "====================================================================================================" << std::endl;
		std::cout << std::endl;

		glfwTerminate();

		return -1;
	}

	glfwMakeContextCurrent(displayerWindowComponent);

	glfwSwapInterval(1);

	if (!gladLoadGLLoader((GLADloadproc)glfwGetProcAddress))
	{
		std::cout << "====================================================================================================" << std::endl;
		std::cout << "ERROR: FAILED TO INITIALIZE GLAD LIBRARY." << std::endl;
		std::cout << "====================================================================================================" << std::endl;
		std::cout << std::endl;

		glfwTerminate();

		return -1;
	}

	glViewport(0, 0, DisplayerWindowWidth, DisplayerWindowHeight);

	glfwSetFramebufferSizeCallback(displayerWindowComponent,
		[](GLFWwindow* paramWindowComponent, int paramWindowWidth, int paramWindowHeight)
		{
			glViewport(0, 0, paramWindowWidth, paramWindowHeight);
		});

	unsigned int vertexShaderIdentifier = glCreateShader(GL_VERTEX_SHADER);

	const char* vertexShaderSource =
		"#version 330 core\n"
		"layout (location = 0) in vec3 l_l_vertexPosition;\n"
		"layout (location = 1) in vec3 l_l_vertexColor;\n"
		"out vec3 g_l_vertexColor;\n"
		"uniform mat4 projectionTransform;\n"
		"uniform mat4 viewTransform;\n"
		"uniform mat4 modelTransform;\n"
		"void main()\n"
		"{\n"
		"\tgl_Position = projectionTransform * viewTransform * modelTransform * vec4(l_l_vertexPosition.x, l_l_vertexPosition.y, l_l_vertexPosition.z, 1.0);\n"
		"\tg_l_vertexColor = vec3(l_l_vertexColor.r, l_l_vertexColor.g, l_l_vertexColor.b);\n"
		"}\n\0";

	glShaderSource(vertexShaderIdentifier, 1, &vertexShaderSource, nullptr);

	glCompileShader(vertexShaderIdentifier);

	unsigned int fragmentShaderIdentifier = glCreateShader(GL_FRAGMENT_SHADER);

	const char* fragmentShaderSource =
		"#version 330 core\n"
		"out vec4 g_l_fragmentColor;\n"
		"in vec3 g_l_vertexColor;\n"
		"void main()\n"
		"{\n"
		"\tg_l_fragmentColor = vec4(g_l_vertexColor.r, g_l_vertexColor.g, g_l_vertexColor.b, 1.0);\n"
		"}\n\0";

	glShaderSource(fragmentShaderIdentifier, 1, &fragmentShaderSource, nullptr);

	glCompileShader(fragmentShaderIdentifier);

	unsigned int shaderProgramIdentifier = glCreateProgram();

	glAttachShader(shaderProgramIdentifier, vertexShaderIdentifier);

	glAttachShader(shaderProgramIdentifier, fragmentShaderIdentifier);

	glLinkProgram(shaderProgramIdentifier);

	glDeleteShader(vertexShaderIdentifier);

	glDeleteShader(fragmentShaderIdentifier);

	unsigned int projectionTransformLocation = glGetUniformLocation(shaderProgramIdentifier, "projectionTransform");

	unsigned int viewTransformLocation = glGetUniformLocation(shaderProgramIdentifier, "viewTransform");

	unsigned int modelTransformLocation = glGetUniformLocation(shaderProgramIdentifier, "modelTransform");

	unsigned int vertexArrayIdentifier;

	unsigned int vertexBufferIdentifier;

	unsigned int indexBufferIdentifier;

	float vertexBufferContent[] = {
		-0.5f, -0.5f, -0.5f,
		+0.0f, +1.0f, +1.0f,
		-0.5f, +0.5f, -0.5f,
		+0.0f, +1.0f, +1.0f,
		-0.5f, -0.5f, +0.5f,
		+0.0f, +1.0f, +1.0f,
		-0.5f, +0.5f, +0.5f,
		+0.0f, +1.0f, +1.0f,

		+0.5f, -0.5f, -0.5f,
		+1.0f, +0.0f, +0.0f,
		+0.5f, +0.5f, -0.5f,
		+1.0f, +0.0f, +0.0f,
		+0.5f, -0.5f, +0.5f,
		+1.0f, +0.0f, +0.0f,
		+0.5f, +0.5f, +0.5f,
		+1.0f, +0.0f, +0.0f,

		-0.5f, -0.5f, -0.5f,
		+1.0f, +0.0f, +1.0f,
		+0.5f, -0.5f, -0.5f,
		+1.0f, +0.0f, +1.0f,
		-0.5f, -0.5f, +0.5f,
		+1.0f, +0.0f, +1.0f,
		+0.5f, -0.5f, +0.5f,
		+1.0f, +0.0f, +1.0f,

		-0.5f, +0.5f, -0.5f,
		+0.0f, +1.0f, +0.0f,
		+0.5f, +0.5f, -0.5f,
		+0.0f, +1.0f, +0.0f,
		-0.5f, +0.5f, +0.5f,
		+0.0f, +1.0f, +0.0f,
		+0.5f, +0.5f, +0.5f,
		+0.0f, +1.0f, +0.0f,

		-0.5f, -0.5f, -0.5f,
		+1.0f, +1.0f, +0.0f,
		+0.5f, -0.5f, -0.5f,
		+1.0f, +1.0f, +0.0f,
		-0.5f, +0.5f, -0.5f,
		+1.0f, +1.0f, +0.0f,
		+0.5f, +0.5f, -0.5f,
		+1.0f, +1.0f, +0.0f,

		-0.5f, -0.5f, +0.5f,
		+0.0f, +0.0f, +1.0f,
		+0.5f, -0.5f, +0.5f,
		+0.0f, +0.0f, +1.0f,
		-0.5f, +0.5f, +0.5f,
		+0.0f, +0.0f, +1.0f,
		+0.5f, +0.5f, +0.5f,
		+0.0f, +0.0f, +1.0f
	};

	unsigned int indexBufferContent[] = {
		0, 2, 1, 1, 2, 3,
		4, 5, 6, 5, 7, 6,
		8, 9, 10, 9, 11, 10,
		12, 13, 14, 13, 15, 14,
		16, 18, 17, 17, 18, 19,
		20, 21, 22, 21, 23, 22
	};

	glGenVertexArrays(1, &vertexArrayIdentifier);

	glGenBuffers(1, &vertexBufferIdentifier);

	glGenBuffers(1, &indexBufferIdentifier);

	glBindVertexArray(vertexArrayIdentifier);

	glBindBuffer(GL_ARRAY_BUFFER, vertexBufferIdentifier);

	glBufferData(GL_ARRAY_BUFFER, sizeof(vertexBufferContent), vertexBufferContent, GL_STATIC_DRAW);

	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indexBufferIdentifier);

	glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indexBufferContent), indexBufferContent, GL_STATIC_DRAW);

	glEnableVertexAttribArray(0);

	glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (const void*)(0 * sizeof(float)));

	glEnableVertexAttribArray(1);

	glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, 6 * sizeof(float), (const void*)(3 * sizeof(float)));

	glBindVertexArray(0);

	glBindBuffer(GL_ARRAY_BUFFER, 0);
	
	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);

	glEnable(GL_DEPTH_TEST);
	glDepthFunc(GL_LESS);

	glEnable(GL_CULL_FACE);
	glCullFace(GL_BACK);

	while (!glfwWindowShouldClose(displayerWindowComponent))
	{
		if (glfwGetKey(displayerWindowComponent, GLFW_KEY_ESCAPE) == GLFW_PRESS)
		{
			glfwSetWindowShouldClose(displayerWindowComponent, GL_TRUE);
		}

		glClearColor(0.25f, 0.25f, 0.25f, 1.0f);

		glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

		glUseProgram(shaderProgramIdentifier);

		glm::mat4 projectionTransform = glm::perspective(glm::radians(45.0f), (float)DisplayerWindowWidth / (float)DisplayerWindowHeight, 0.1f, 100.0f);

		glm::mat4 viewTransform = glm::lookAt(glm::vec3(3.0f, 2.0f, 5.0f), glm::vec3(0.0f, 0.0f, 0.0f), glm::vec3(0.0f, 1.0f, 0.0f));

		glm::mat4 modelTransform = glm::identity<glm::mat4>();
		modelTransform = glm::translate(modelTransform, glm::vec3(-2.0f, -1.0f, -1.0f));
		modelTransform = glm::rotate(modelTransform, glm::radians(45.0f) + (float)glfwGetTime(), glm::vec3(1.0f, .0f, 1.0f));
		modelTransform = glm::scale(modelTransform, glm::vec3(2.0f, 0.5f, 2.0f));

		glUniformMatrix4fv(projectionTransformLocation, 1, GL_FALSE, glm::value_ptr(projectionTransform));

		glUniformMatrix4fv(viewTransformLocation, 1, GL_FALSE, glm::value_ptr(viewTransform));

		glUniformMatrix4fv(modelTransformLocation, 1, GL_FALSE, glm::value_ptr(modelTransform));

		glBindVertexArray(vertexArrayIdentifier);

		glDrawElements(GL_TRIANGLES, sizeof(indexBufferContent) / sizeof(unsigned int), GL_UNSIGNED_INT, (const void*)(0 * sizeof(unsigned int)));

		glfwSwapBuffers(displayerWindowComponent);

		glfwPollEvents();
	}

	glDeleteVertexArrays(1, &vertexArrayIdentifier);

	glDeleteBuffers(1, &vertexBufferIdentifier);

	glDeleteBuffers(1, &indexBufferIdentifier);

	glDeleteProgram(shaderProgramIdentifier);

	glfwDestroyWindow(displayerWindowComponent);

	glfwTerminate();

	std::cout << std::endl;
	std::cout << "====================================================================================================" << std::endl;
	std::cout << "PRESS [ENTER] KEY TO CLOSE CONSOLE..." << std::endl;
	std::cout << "====================================================================================================" << std::endl;
	std::cout << std::endl;

	std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');

	std::cout << "====================================================================================================" << std::endl;
	std::cout << "----------------------------------------------------------------------------------------------------" << std::endl;
	std::cout << "====================================================================================================" << std::endl;

	return std::cin.get();
}
