#include <iostream>
#include <fstream>
#include <sstream>
#include <string>

inline static const std::string AnalyzePipelineDocument(const std::string& pipelineDocumentLocation)
{
	std::ifstream pipelineDocumentArchive = std::ifstream(pipelineDocumentLocation, std::ios::in | std::ios::binary);

	if (pipelineDocumentArchive.is_open() == false)
	{
		return std::string();
	}

	const std::istreambuf_iterator<char> pipelineDocumentBeginIterator = std::istreambuf_iterator<char>(pipelineDocumentArchive);
	const std::istreambuf_iterator<char> pipelineDocumentEndIterator = std::istreambuf_iterator<char>();

	const std::string pipelineDocumentContent = std::string(pipelineDocumentBeginIterator, pipelineDocumentEndIterator);

	pipelineDocumentArchive.close();

	return pipelineDocumentContent;
}

inline static const std::string ExtractPipelineSegment(const std::string& pipelineDocumentSource, const std::string& documentSegmentName)
{
	const std::string pipelineDocumentOpeningTag = ">>>>>>>>>>>>>>>>>>>> " + documentSegmentName + " >>>>>>>>>>>>>>>>>>>>";
	const std::string pipelineDocumentClosureTag = "<<<<<<<<<<<<<<<<<<<< " + documentSegmentName + " <<<<<<<<<<<<<<<<<<<<";

	const std::string_view pipelineDocumentContent_ = std::string_view(pipelineDocumentSource);

	const std::size_t pipelineDocumentSegmentBegin = pipelineDocumentContent_.find(pipelineDocumentOpeningTag);
	const std::size_t pipelineDocumentSegmentEnd = pipelineDocumentContent_.find(pipelineDocumentClosureTag, pipelineDocumentSegmentBegin);

	if (pipelineDocumentSegmentBegin == std::string::npos || pipelineDocumentSegmentEnd == std::string::npos)
	{
		return std::string();
	}

	const size_t pipelineDocumentContentBegin = pipelineDocumentSegmentBegin + pipelineDocumentOpeningTag.length();
	const size_t pipelineDocumentContentLength = pipelineDocumentSegmentEnd - pipelineDocumentContentBegin;

	const std::string_view pipelineDocumentSegment_ = pipelineDocumentContent_.substr(pipelineDocumentContentBegin, pipelineDocumentContentLength);

	const size_t pipelineDocumentTrimBegin = pipelineDocumentSegment_.find_first_not_of("\r\n");
	const size_t pipelineDocumentTrimEnd = pipelineDocumentSegment_.find_last_not_of("\r\n");

	if (pipelineDocumentTrimBegin == std::string::npos)
	{
		return std::string();
	}

	const std::string pipelineDocumentSegment = std::string(pipelineDocumentSegment_.substr(pipelineDocumentTrimBegin, pipelineDocumentTrimEnd - pipelineDocumentTrimBegin + 1));

	return pipelineDocumentSegment;
}

